{
  "name": "sentinel-cloudflare",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Sentinel Luau project, build, and license management platform for Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
